# Nginx Proxy Manager + Let's Encrypt configuration is done from UI (port 81).
# No DOMAIN/SSL file env vars are required in compose.

# Vite build-time variables (optional, set if used by your app)
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
VITE_RECAPTCHA_SITE_KEY=
